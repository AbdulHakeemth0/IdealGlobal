<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="crm_team_sales_teams_view_form" model="ir.ui.view">
            <field name="name">crm.team.forms</field>
            <field name="model">crm.team</field>
            <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='name']" position="before">
                    <button name="prefix_generate" type="object" class="btn-primary" string="PREFIX"/><br/>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="prefix_name" required="1"/>
                    <field name="prefix_code_sale" required="1"/>
                    <field name="prefix_code_invoice" required="1"/>
                    <field name="prefix_code_debit" required="1"/>
                    <field name="prefix_code_delivery" required="1"/>
                    <field name="prefix_code_expense" required="1"/>
                    <field name="prefix_letter_sale" required="1"/>
                    <field name="prefix_letter_invoice" required="1"/>
                    <field name="prefix_letter_debit" required="1"/>
                    <field name="prefix_letter_delivery" required="1"/>
                    <field name="prefix_letter_expense" required="1"/>
                    <field name="prefix_padding" required="1"/>
                    <field name="sale_account"/>
                    <field name="cash_account"/>
                    <field name="customer_receivable_account" />
                    <field name="customer_payable_account"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
