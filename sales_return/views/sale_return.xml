<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="order_form_inherit_sale_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.new.sale</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="sale_return" invisible="1"/>
                    <field name="return_sale" invisible="1"/>
                    <field name="date" force_save="1" attrs="{'invisible': [('sale_return', '!=', True)]}"/>
                </xpath>

                <button name="action_preview_sale_order" position="after">
                    <button name="action_view_picking" type="object"
                            class="oe_stat_button" icon="fa-users" attrs="{'invisible': [('sale_return', '!=', True)]}">
                        <field name="picking_count" widget="statinfo" force_save="1" string="Transfer" attrs="{'invisible': [('sale_return', '!=', True)]}"/>
                    </button>
                    <button name="view_sale_return" type="object"
                            class="oe_stat_button" string="Returns" icon="fa-refresh" attrs="{'invisible': [('return_sale', '!=', True)]}">
<!--                        <field name="return_count" widget="statinfo" force_save="1" string="Return" attrs="{'invisible': [('sale_return', '=', True)]}"/>-->
                    </button>
                    <button name="action_view_debit" type="object"
                            class="oe_stat_button" icon="fa-history" attrs="{'invisible': [('sale_return', '!=', True)]}">
                        <field name="debit_count" widget="statinfo" force_save="1" string="Debit Note" attrs="{'invisible': [('sale_return', '!=', True)]}"/>
                    </button>
                </button>

                <xpath expr="//button[@name='action_quotation_send'][1]" position="after">
                    <button name="action_confirm_return" string="Return" type="object" attrs="{'invisible': ['|',('state', 'not in', ['draft']), ('sale_return', '!=', True)]}"/>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="replace">
                    <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'sent','sale', 'return']), ('id', '=', False)]}" data-hotkey="z"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="draft"/>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][1]" position="replace">
                    <field name="sale_return" invisible="1"/>
                    <button name="action_confirm" id="action_confirm" data-hotkey="v" string="Confirm" class="btn-primary" type="object" context="{'validate_analytic': True}" attrs="{'invisible': ['|',('state', 'not in', ['sent']), ('sale_return', '=', True)]}"/>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][2]" position="replace">
                    <field name="sale_return" invisible="1"/>
                    <button name="action_confirm" data-hotkey="v" string="Confirm" type="object" context="{'validate_analytic': True}" attrs="{'invisible': ['|',('state', 'not in', ['draft']), ('sale_return', '=', True)]}"/>
                </xpath>
                <xpath expr="//notebook/page/field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                    <field name="sale_return" invisible="1"/>
                    <button name="open_return_wizard" type="object" title="Orders" icon="fa-history" attrs="{'invisible': [('sale_return', '!=', True)]}"/>
                </xpath>
                <xpath expr="//group[@name='sale_header']/group[@name='order_details']" position="attributes">
                    <attribute name="attrs">{'invisible': [('sale_return', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//notebook/page[@name='other_information']" position="attributes">
                    <attribute name="attrs">{'invisible': [('sale_return', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//notebook/page[@name='customer_signature']" position="attributes">
                    <attribute name="attrs">{'invisible': [('sale_return', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

