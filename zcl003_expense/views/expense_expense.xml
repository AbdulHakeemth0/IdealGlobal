<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_expense_form" model="ir.ui.view">
            <field name="name">Vehicle Fule Maintenance</field>
            <field name="model">expense.expense</field>
            <field name="arch" type="xml">
                <form sting="Expense">
                    <header>
                        <button name="action_confirm_expense" type="object" class="btn-primary" string="Confirm" attrs="{'invisible':[('state','!=','draft')]}"/>
                        <button name="action_create_payment" type="object"
                                string="Create Payment" class="btn-primary" attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                        <button name="action_cancel_expense" string="Cancel" type="object" class="oe_highlight"/>
                        <button name="draft_action_type" type="object" class="btn-primary" string="Re set Draft" attrs="{'invisible':[('state','!=','cancel')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                             <button name="action_view_payment" type="object"
                                class="oe_stat_button" icon="fa-users">
                                <field name="payment_count" widget="statinfo" string="Payment"/>
                             </button>
                        </div>
                        <h1>
                            <field name="ref"/>
                        </h1>
                        <group>
                            <field name="empo_name_ids"/>
                            <field name="date_due"/>
                            <field name="type_expense"/>
                            <field name="journal_id"/>
                            <field name="vat"/>
                            <field name="payment_method_line_id"/>
                            <field name="expense_acc_ids" invisible="1"/>
                            <field name="amount"/>
                            <field name="branch_id"/>
                            <field name="kilometer"/>
                            <field name="number_plate"/>
                            <field name="narration"/>
                            <field name="remarks"/>
                        </group>
                         <notebook>
                             <page string="Journal Item" name="journal_expence_line">
                                <field name="journal_expence_line_ids">
                                   <tree editable="bottom">
                                       <field name="expence_fuel" force_save="1" invisible="1"/>
                                       <field name="debit_account" force_save="1"/>
                                       <field name="debit" force_save="1"/>
                                   </tree>
                                </field>
                             </page>
                        </notebook>
                        <field name="total" force_save="1" position="attributes">
                            <attribute name="widget">monetary</attribute>
                        </field>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="view_expense_tree" model="ir.ui.view">
            <field name="name">Vehicle Fule  Maintenance</field>
            <field name="model">expense.expense</field>
            <field name="arch" type="xml">
                <tree string="Expense" default_order="create_date desc">
                    <field name="ref"/>
                    <field name="empo_name_ids"/>
                    <field name="date_due"/>
                    <field name="type_expense"/>
                    <field name="journal_id"/>
                    <field name="vat"/>
                    <field name="payment_method_line_id"/>
                    <field name="expense_acc_ids"/>
                    <field name="amount"/>
                    <field name="kilometer"/>
                    <field name="number_plate"/>
                    <field name="narration"/>
                    <field name="remarks"/>
                    <field name="state"/>

                </tree>
            </field>
        </record>

        <record id="view_expense_search" model="ir.ui.view">
            <field name="name">Vechile Fule  Maintenance</field>
            <field name="model">expense.expense</field>
            <field name="arch" type="xml">
                <search string="Search Expense">
                    <filter name="empo_name_ids" help="empo_name_ids"/>
                    <filter name="number_plate" help="number_plate"/>
                    <filter name="type_expense" help="type_expense"/>
                </search>
            </field>
        </record>

        <record id="action_expense_master_id" model="ir.actions.act_window">
            <field name="name">Vechile Fule  Maintenance</field>
            <field name="res_model">expense.expense</field>
            <field name="view_mode">tree,form</field>
        </record>



    </data>
</odoo>