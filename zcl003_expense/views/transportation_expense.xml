<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_transportation_form" model="ir.ui.view">
            <field name="name">Transportation Indirect Exp</field>
            <field name="model">transportation.expense</field>
            <field name="arch" type="xml">
                    <form sting="Transportation">
                        <header>
                                <button name="action_confirm_transportation" type="object" class="btn-primary" string="Confirm" attrs="{'invisible':[('state','!=','draft')]}"/>
                                <button name="action_create_payment" type="object"
                                string="Create Payment" class="btn-primary" attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                                <button name="action_cancel_transportation" string="Cancel" type="object" class="oe_highlight"/>
                                <button name="draft_action_type" type="object" class="btn-primary" string="Re set Draft" attrs="{'invisible':[('state','!=','cancel')]}"/>
                               <field name="state" widget="statusbar" statusbar_visible="draft,confirm,cancel"/>
                        </header>
                        <sheet>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_view_payment" type="object"
                                        class="oe_stat_button" icon="fa-users">
                                      <field name="payment_count" widget="statinfo" string="Payment"/>
                                </button>
                            </div>
                            <h1>
                                   <field name="ref"/>
                            </h1>
                            <group>
                                <field name="empo_name_ids"/>
                                <field name="date_due"/>
                                <field name="journal_id"/>
                                <field name="vat"/>
                                <field name="payment_method_line_id"/>
                                <field name="expense_acc_ids"/>
                                <field name="amount"/>
                                <field name="bill_ref"/>
                                <field name="branch_id"/>
                                <field name="remarks"/>
                            </group>
                            <notebook>
                               <page string="Journal Item" name="journal_expence_line">
                                  <field name="journal_expence_line_ids">
                                     <tree editable="bottom">
                                         <field name="expence_transportation" force_save="1" invisible="1"/>
                                         <field name="debit_account" force_save="1"/>
                                         <field name="debit" force_save="1"/>
                                     </tree>
                                  </field>
                               </page>
                            </notebook>
                            <field name="total" force_save="1" position="attributes">
                               <attribute name="widget">monetary</attribute>
                            </field>
                        </sheet>
                        <div class="oe_chatter">
                                 <field name="message_follower_ids"/>
                                 <field name="message_ids"/>
                        </div>
                    </form>
            </field>
        </record>
         <record id="view_transportation_tree" model="ir.ui.view">
            <field name="name">Transportation Indirect Exp</field>
            <field name="model">transportation.expense</field>
            <field name="arch" type="xml">
                <tree string="Transportation Indirect" default_order="create_date desc">
                    <field name="ref"/>
                    <field name="empo_name_ids"/>
                    <field name="date_due"/>
                    <field name="journal_id"/>
                    <field name="vat"/>
                    <field name="payment_method_line_id"/>
                    <field name="expense_acc_ids"/>
                    <field name="amount"/>
                    <field name="bill_ref"/>
                    <field name="remarks"/>
                </tree>
            </field>
         </record>
        <record id="view_transportation_search" model="ir.ui.view">
            <field name="name">Transportation Exp</field>
            <field name="model">transportation.expense</field>
            <field name="arch" type="xml">
                <search string="Search Transportation">
                    <filter name="empo_name_ids" help="empo_name_ids"/>
                </search>
            </field>
        </record>
        <record id="action_transportation_master_id" model="ir.actions.act_window">
            <field name="name">Transportation Exp</field>
            <field name="res_model">transportation.expense</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>