<odoo>
    <record id="sale_foc_view_form" model="ir.ui.view">
        <field name="name">sale.foc.view.form</field>
        <field name="model">sale.foc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="foc_product_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="subtotal" sum="Total"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="confirm_foc" string="CONFIRM" type="object" class="oe_highlight"/>
                    <button special="cancel" string="CANCEL"/>
                </footer>
            </form>
        </field>
    </record>
