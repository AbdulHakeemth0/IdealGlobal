<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="category_foc_sale_view_form" model="ir.ui.view">
            <field name="name">category.foc.view.form</field>
            <field name="model">category.foc.sale</field>
            <field name="arch" type="xml">
                <form string="FOC">
                    <sheet>
                        <group>
                            <field name="document_number"/>
                            <field name="foc_name"/>
                            <field name="limit"/>
                            <field name="product_category"/>
                            <field name="percentage"/>
                            <field name="product_lines">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="category_foc_sale_view_tree" model="ir.ui.view">
            <field name="name">category.foc.view.tree</field>
            <field name="model">category.foc.sale</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="document_number"/>
                    <field name="foc_name"/>
                    <field name="limit"/>
                    <field name="product_category"/>
                    <field name="percentage"/>
                </tree>
            </field>
        </record>

        <record id="action_category_foc" model="ir.actions.act_window">
            <field name="name">Category FOC</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_id" ref="zcl006_sale_foc.category_foc_sale_view_tree"/>
            <field name="res_model">category.foc.sale</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Category FOC!
                </p>
            </field>
        </record>

        <menuitem id="menu_category_foc"
                  name="Category FOC"
                  parent="zcl006_sale_foc.menu_sale_foc"
                  action="action_category_foc"
                  sequence="3"/>

    </data>

</odoo>
