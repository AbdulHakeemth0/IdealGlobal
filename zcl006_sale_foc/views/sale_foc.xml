<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="second_foc_sale_view_form" model="ir.ui.view">
            <field name="name">second.foc.view.form</field>
            <field name="model">second.foc.sale</field>
            <field name="arch" type="xml">
                <form string="FOC">
                    <sheet>
                        <group>
                            <field name="document_number"/>
                            <field name="foc_name"/>
                            <field name="limit"/>
                            <field name="percentage"/>
                            <!--                            <field name="percentage" widget='percentage'/>-->
                            <field name="product_lines">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <!--                                    <field name="product_qty"/>-->
                                    <!--                                    <field name="subtotal" sum="Total"/>-->
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="second_foc_sale_view_tree" model="ir.ui.view">
            <field name="name">second.foc.view.tree</field>
            <field name="model">second.foc.sale</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="document_number"/>
                    <field name="foc_name"/>
                    <field name="limit"/>
                    <field name="percentage"/>
                </tree>
            </field>
        </record>

        <record id="action_second_foc" model="ir.actions.act_window">
            <field name="name">Product FOC</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_id" ref="zcl006_sale_foc.second_foc_sale_view_tree"/>
            <field name="res_model">second.foc.sale</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new FOC!
                </p>
            </field>
        </record>
        <menuitem id="menu_sale_foc"
                  name="FOC"
                  parent="sale.sale_menu_root"
                  sequence="60"/>
        
        <menuitem id="menu_sub_foc"
                  name="Product FOC"
                  parent="menu_sale_foc"
                  action="action_second_foc"
                  sequence="2"/>


    </data>

</odoo>
