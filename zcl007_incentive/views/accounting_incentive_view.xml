<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <record id="sale_incentive_view_form" model="ir.ui.view">
            <field name="name">sale.incentive.view.form</field>
            <field name="model">sale.incentive</field>
            <field name="arch" type="xml">
                <form string="FOC">
                    <sheet>
                        <group>
                            <group>
                                <field name="zone"/>
                                <label for="date_from" string="Planned Date"/>
                            <div name="dates" class="o_row">
                                <field name="date_from" widget="daterange" options='{"related_end_date": "date_to"}'/>
                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" attrs="{'invisible': [('date_from', '=', False), ('date_to', '=', False)]}"/>
                                <field name="date_to" widget="daterange" options='{"related_start_date": "date_start"}'/>
                            </div>
                                <field name="target"/>
                                <field name="amount"/>
                            </group>
                            <group string="Deduction Amount">
                                <field name="deduction_0_15"/>
                                <field name="deduction_15_25"/>
                                <field name="deduction_25_35"/>
                                <field name="deduction_above_35"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="sale_incentive_view_tree" model="ir.ui.view">
            <field name="name">sale.incentive.view.tree</field>
            <field name="model">sale.incentive</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="zone"/>
                    <field name="target"/>
                    <field name="amount"/>
                </tree>
            </field>
        </record>

        <record id="action_sale_incentive" model="ir.actions.act_window">
            <field name="name">Sale Incentive</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_id" ref="zcl007_incentive.sale_incentive_view_tree"/>
            <field name="res_model">sale.incentive</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Incentive!
                </p>
            </field>
        </record>

        <menuitem id="menu_incentive_root"
                  name="Incentive"
                  parent="account.menu_finance"
                  sequence="23"/>

        <menuitem id="menu_sale_incentive"
                  name="Sale Incentive"
                  parent="menu_incentive_root"
                  action="action_sale_incentive"
                  sequence="2"/>
    </data>
</odoo>