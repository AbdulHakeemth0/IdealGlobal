<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="collection_incentive_view_form" model="ir.ui.view">
        <field name="name">collection.incentive.view.form</field>
        <field name="model">collection.incentive</field>
        <field name="arch" type="xml">
            <form string="FOC" editable="0">
                <sheet>
                    <group>
                        <field name="zone"/>
                        <field name="user_id" store="True"/>
                        <field name="collection_incentive_amount"/>
                    </group>
                    <notebook>
                        <page name="Invoices">
                            <field name="invoice_ids" readonly="1" force_save="1">
                                <tree editable="0" create="0">
                                    <field name="invoice_id"/>
                                    <field name="date"/>
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="collection_incentive"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="collection_incentive_view_tree" model="ir.ui.view">
        <field name="name">collection.incentive.view.tree</field>
        <field name="model">collection.incentive</field>
        <field name="arch" type="xml">
            <tree>
                <field name="zone"/>
                <field name="user_id"/>
                <field name="collection_incentive_amount"/>
            </tree>
        </field>
    </record>

    <record id="action_collection_incentive" model="ir.actions.act_window">
        <field name="name">Collection Incentive</field>
        <field name="res_model">collection.incentive</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Incentive!
            </p>
        </field>
    </record>

    <menuitem id="menu_collection_incentive"
          name="Collection Incentive"
          parent="menu_incentive_root"
          action="action_collection_incentive"
          sequence="4"/>


</odoo>