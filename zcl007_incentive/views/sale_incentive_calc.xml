<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>

        <!-- Define tree view for crm.team -->
        <record id="crm_team_tree_view" model="ir.ui.view">
            <field name="name">crm.team.tree.view</field>
            <field name="model">crm.team</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button string="Calculate Values" type="object" name="button_calculate_values" class="oe_highlight"/>
                    </header>
                    <field name="name"/>
                    <field name="target"/>
                    <field name="total_sale_amount"/>
                    <field name="achieved_percentage"/>
                    <field name="deduction_percentage"/>
                    <field name="incentive_type"/>
                    <field name="incentive" decoration-danger="incentive_type == 'deduction'" decoration-success="incentive > 0"/>
                    <field name="date_from" optional="hide"/>
                    <field name="date_to" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- Modify the menu action to use crm.team tree view -->
        <record id="action_sale_incentive_calculation_new" model="ir.actions.act_window">
            <field name="name">Sale Incentive Calculation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="crm_team_tree_view"/>
            <field name="res_model">crm.team</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Incentive!
                </p>
            </field>
        </record>

        <menuitem id="menu_sale_incentive_calculation_new"
                  name="Sales Incentive Calculation"
                  parent="menu_incentive_root"
                  action="action_sale_incentive_calculation_new"
                  sequence="4"/>
    </data>
</odoo>