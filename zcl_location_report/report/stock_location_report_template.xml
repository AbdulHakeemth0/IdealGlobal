<odoo>
    <data>
        <template id="stock_location_pdf_report_template">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <header>
                        <style>
                            table, th, td {
                            border:1px solid black;
                            border-collapse: collapse;
                            }
                        </style>
                    </header>
                    <div align="center">
                        <h2>Locations</h2>
                    </div>
                    <br/>
                    <table clas="table table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>Location</th>
                                <th>Product</th>
                                <th>Lot/Serial Number</th>
                                <th>Oh Hand Quantity</th>
                                <th>Reserved Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="index" t-value="1"/>
                            <t t-foreach="list_data" t-as="data">
                                <tr>
                                    <td>
                                        <t t-esc="index"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['location']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['product']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['lot_serial_no']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['on_hand_quantity']"/>
                                    </td>
                                    <td>
                                        <t t-esc="data['reserved_quantity']"/>
                                    </td>
                                </tr>
                                <t t-set="index" t-value="index+1"/>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </template>
    </data>
</odoo>
