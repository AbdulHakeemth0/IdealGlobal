<odoo>

    <record id="stock_location_pdf_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.location.pdf.wizard.form</field>
        <field name="model">stock.location.pdf.wizard</field>
        <field name="arch" type="xml">
            <form string="Location Report">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="stock_location_print_pdf"
                            string="Print Report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_location_pdf_report_action"
            model="ir.actions.act_window">
        <field name="name">Location PDF Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.location.pdf.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_location_pdf_wizard_view_form"/>
        <field name="target">new</field>
    </record>

</odoo>
