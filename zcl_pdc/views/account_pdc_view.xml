<odoo>
    <record id="account_pdc_view_form" model="ir.ui.view">
        <field name="name">account.pdc.view.form</field>
        <field name="model">account.pdc</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="pdc_confirm" string="POST"
                            type="object" class="oe_highlight" states="draft"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="payment_method"/>
                            <field name="payment_type"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="payment_from_date"/>
                            <field name="payment_to_date"/>
                            <field name="effective_from_date"/>
                            <field name="effective_to_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="account_pdc_view_tree" model="ir.ui.view">
        <field name="name">account.pdc.view.tree</field>
        <field name="model">account.pdc</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="payment_type"/>
                <field name="amount"/>
                <field name="journal_id"/>
                <field name="payment_from_date"/>
                <field name="payment_to_date"/>
                <field name="effective_from_date"/>
                <field name="effective_to_date"/>
            </tree>
        </field>
    </record>

    <record id="action_account_pdc" model="ir.actions.act_window">
        <field name="name">Account PDC</field>
        <field name="res_model">account.pdc</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_account_pdc"
              name="PDC"
              parent="account.menu_finance_entries"
              action="action_account_pdc"
              sequence="3"/>
</odoo>