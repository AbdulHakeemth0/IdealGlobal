<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="price_list_category_tree" model="ir.ui.view">
        <field name="name">price.category.tree</field>
        <field name="model">price.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="price_list_category_form" model="ir.ui.view">
        <field name="name">price.category.form</field>
        <field name="model">price.category</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_code"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="price_list_category_action" model="ir.actions.act_window">
        <field name="name">Price Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">price.category</field>
    </record>
</odoo>
