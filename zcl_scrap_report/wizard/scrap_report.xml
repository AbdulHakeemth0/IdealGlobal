<odoo>
    <record id="scrap_pdf_wizard_view_form" model="ir.ui.view">
        <field name="name">scrap.pdf.wizard.form</field>
        <field name="model">scrap.pdf.wizard</field>
        <field name="arch" type="xml">
            <form string="Scrap Report">
                <sheet>
                    <group>
                        <field name="product_id" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button name="scrap_print_pdf" string="Print Report"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="scrap_pdf_report_action" model="ir.actions.act_window">
        <field name="name">Scrap PDF Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scrap.pdf.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="scrap_pdf_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
