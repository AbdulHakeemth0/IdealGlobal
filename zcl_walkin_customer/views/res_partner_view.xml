<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!--        Inherited res partner mode for adding pay on account boolean field-->
        <record id="res_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mobile']" position="after">
                    <field name="walkin_customer" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='contact_addresses']" position="after">
                    <page name='walkin_cust' string="Walk-in customer" attrs="{'invisible': [('walkin_customer', '=', False)]}">
                            <field name="walkin_customer_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="phone"/>
                                </tree>
                            </field>
                        </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
